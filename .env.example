# Docker Compose 环境变量示例：复制为 .env 后修改
# cp .env.example .env

# 对外访问端口（前端页面与 API 同一个容器、同一个端口）
WEB_PORT=8088

# MySQL
MYSQL_ROOT_PASSWORD=please-change-root-password
DB_NAME=miniwho
DB_USER=miniwho
DB_PASSWORD=please-change-db-password

# 首次启动是否创建 demo / admin 演示账号
MINIWHO_SEED_DEMO=true
MINIWHO_DEMO_PASSWORD=demo123
MINIWHO_ADMIN_PASSWORD=please-change-admin-password

# 允许跨域访问 API 的来源。默认 * 放行任意来源（认证走 satoken 请求头，不携带 Cookie），
# 反向代理到自定义域名、换 IP、前后端分离部署都不用改；
# 需要收紧时填逗号分隔的具体来源，例如 https://resume.example.com。
MINIWHO_CORS_ORIGINS=*

# 头像等媒体链接的 HMAC 签名密钥。留空则每次启动随机生成，
# 重启后旧的头像链接会失效；多实例部署必须显式设置一个随机长字符串。
MINIWHO_MEDIA_SECRET=

# 服务端 PDF 导出（镜像内已内置 chromium + Noto CJK 字体）
MINIWHO_PDF_ENABLED=true
# 无头浏览器访问导出页面的地址。页面与 API 在同一个容器里，保持指向自身即可；
# 只有把页面拆到别的域名/容器时才需要改。
MINIWHO_PDF_RENDER_BASE_URL=http://127.0.0.1:8080
