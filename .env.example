# Docker Compose 环境变量示例：复制为 .env 后修改
# cp .env.example .env

# 对外访问端口（前端页面与 API 同一个容器、同一个端口）
WEB_PORT=8088

# MySQL
MYSQL_ROOT_PASSWORD=please-change-root-password
DB_NAME=miniwho
DB_USER=miniwho
DB_PASSWORD=please-change-db-password

# 首次启动是否创建 demo / admin 演示账号
MINIWHO_SEED_DEMO=true
MINIWHO_DEMO_PASSWORD=demo123
MINIWHO_ADMIN_PASSWORD=please-change-admin-password

# 允许跨域访问 API 的来源。默认 * 放行任意来源（认证走 satoken 请求头，不携带 Cookie），
# 反向代理到自定义域名、换 IP、前后端分离部署都不用改；
# 需要收紧时填逗号分隔的具体来源，例如 https://resume.example.com。
MINIWHO_CORS_ORIGINS=*

# 头像等媒体链接的 HMAC 签名密钥。留空则每次启动随机生成，
# 重启后旧的头像链接会失效；多实例部署必须显式设置一个随机长字符串。
MINIWHO_MEDIA_SECRET=

# 服务端 PDF 导出（镜像内已内置 chromium + Noto CJK 字体）
MINIWHO_PDF_ENABLED=true
# 同时运行的 Chromium 实例上限（每个实例峰值几百 MB）和排队等待秒数；
# 小内存服务器保持 2 / 20 即可，超出上限的导出会排队，等不到则返回「任务繁忙」。
MINIWHO_PDF_MAX_CONCURRENT=2
MINIWHO_PDF_QUEUE_TIMEOUT=20
# 无头浏览器访问导出页面的地址。页面与 API 在同一个容器里，保持指向自身即可；
# 只有把页面拆到别的域名/容器时才需要改。
MINIWHO_PDF_RENDER_BASE_URL=http://127.0.0.1:8080

# ------------------------------------------------------------------
# 注册 / 登录方式（全部可选）
# 用户名注册、邮箱注册、GitHub 登录三个开关都在管理后台「认证设置」里，
# 但只有对应通道的凭据配齐了，开关才真的生效、前台才会出现对应入口。
# 下面的凭据也可以不填：直接在后台「认证设置 → 通道配置」里填，保存即生效、不用重启。
# 同名的一项后台填过就以库里的为准，这里只是后台没填时的默认来源。
# 三者都不配置时，站点没有自助注册，只能由管理员建号。
# ------------------------------------------------------------------

# 站点对外地址，https 带域名，末尾不带斜杠。GitHub 回调地址与登录完成后的跳转都从它拼出来；
# 要用 GitHub 登录就必须填。
MINIWHO_PUBLIC_BASE_URL=

# 邮箱注册用的标准 SMTP。QQ / 163 等个人邮箱填「授权码」，不是邮箱登录密码；
# 授权码申请后 QQ 的 SMTP 走 465 + SSL（保持下面默认），163 同样 465。
MINIWHO_MAIL_HOST=
MINIWHO_MAIL_PORT=465
MINIWHO_MAIL_USERNAME=
MINIWHO_MAIL_PASSWORD=
MINIWHO_MAIL_FROM=
MINIWHO_MAIL_FROM_NAME=极简简历
# 465 用隐式 SSL；587 之类改成 MINIWHO_MAIL_SSL=false + MINIWHO_MAIL_STARTTLS=true
MINIWHO_MAIL_SSL=true
MINIWHO_MAIL_STARTTLS=false

# GitHub OAuth App（Settings → Developer settings → OAuth Apps）
# 回调地址填 https://<你的域名>/api/auth/oauth/github/callback，与后台「认证设置」页显示的一致。
MINIWHO_GITHUB_CLIENT_ID=
MINIWHO_GITHUB_CLIENT_SECRET=
